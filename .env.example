# ──────────────────────────────────────────────
# 阅己 ReadSoul 环境变量
# 复制本文件为 .env.local 后填写
# ──────────────────────────────────────────────

# 微信读书 Skill 版本号（与 weread-skill 保持一致，后端代理会自动注入）
WEREAD_SKILL_VERSION=1.0.3

# ── Beta 试用门禁（AI 接口鉴权，前后端需一致）──
# 服务端校验 X-ReadSoul-Beta 请求头；不填则跳过门禁（仅本地开发）
# 生成：npm run gen:beta-secret  或  npm run gen:beta-secret -- --write
BETA_GATE_SECRET=
NEXT_PUBLIC_BETA_GATE_SECRET=

# ── 可观测性（可选）──
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ── AI 阅读人格分析（OpenAI 兼容接口）──
# 兼容 OpenAI / DeepSeek / 通义千问 等。不填则人格分析自动降级为规则式生成。
# 示例（DeepSeek）：
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
# 示例（OpenAI）：
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ── 观点织网（Embedding + 聚类）──
# 对话与 Embedding 可分开配置。DeepSeek 不含 /embeddings，需单独指定 Embedding 服务。
#
# 推荐：硅基流动 + Qwen3（中文语义更好，比 OpenAI small 更适合微信读书划线）
#   AI_EMBED_BASE_URL=https://api.siliconflow.cn/v1
#   AI_EMBED_API_KEY=你的硅基流动Key
#   AI_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
#   AI_EMBED_DIMENSIONS=1024
#
# 或 OpenAI：
#   AI_EMBED_BASE_URL=https://api.openai.com/v1
#   AI_EMBED_MODEL=text-embedding-3-small
#
# AI_EMBED_BASE_URL=
# AI_EMBED_API_KEY=
# AI_EMBED_MODEL=
# AI_EMBED_DIMENSIONS=
INSIGHT_BUILD_BATCH=64
NEXT_PUBLIC_INSIGHT_CACHE_TTL_DAYS=7
